# Runtime configuration used by this project.
# Real values are injected by the deployment runtime — never commit real keys.
# Publishable/anon values are safe to expose to the browser; everything else must stay server-side.

# Supabase (Lovable Cloud) — publishable, safe for the browser
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project-ref.supabase.co

# Vite-exposed equivalents (browser)
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side only (inject through deployment secrets; never commit real values)
# LOVABLE_API_KEY=
# LOVABLE_SEND_URL=
# LOVABLE_CRON_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# WhatsApp Business Platform / Meta Cloud API (server-side only)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_API_VERSION=
# Public display number shown to students (E.164 format, e.g. +15551234567)
# WHATSAPP_BUSINESS_PHONE_NUMBER=
