# Runtime configuration used by this project.
# Real values are injected by the Lovable Cloud runtime — never commit real keys.
# Publishable/anon values are safe to expose to the browser; everything else must stay server-side.

# Supabase (Lovable Cloud) — publishable, safe for the browser
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project-ref.supabase.co

# Vite-exposed equivalents (browser)
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side only (injected by Lovable Cloud; do not place in files)
# LOVABLE_API_KEY=
# LOVABLE_SEND_URL=
# LOVABLE_CRON_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
